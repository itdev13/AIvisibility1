{
  "name": "seowavetech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev -p 3100\" \"tsx watch --env-file-if-exists=.env src/worker/index.ts\"",
    "dev:web": "next dev -p 3100",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsx --env-file-if-exists=.env scripts/seed-admin.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "marked": "^18.1.3",
    "mongoose": "^9.12.0",
    "next": "^15.5.29",
    "node-cron": "^4.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=22.9"
  }
}
