# ─── Core ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3100
MONGODB_URI=mongodb://127.0.0.1:27017/seowavetech
# 32+ random chars: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated emails that get the internal Ops console (/admin)
ADMIN_EMAILS=james@seowavetech.com,srinivas@seowavetech.com
# Shared secret for /api/cron/* when using an external scheduler (Vercel Cron etc.)
CRON_SECRET=change-me

# ─── AI engines (tracking) — any engine without a key is skipped ───────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
ANTHROPIC_API_KEY=
# Model used when Claude is tracked as an engine
ANTHROPIC_TRACK_MODEL=claude-sonnet-5-5
# Model used internally (question generation, mention extraction, drafting)
ANTHROPIC_WORK_MODEL=claude-sonnet-5-5
# Cheap model for per-answer brand extraction
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Set to false to use regex-only mention detection (cheaper, less accurate positions)
LLM_EXTRACTION=true
XAI_API_KEY=
XAI_MODEL=grok-4

# Answers sampled per question per engine (AI answers vary run to run)
TRACK_SAMPLES=1

# ─── Apify (Google, AI Overviews, AI Mode, Copilot, Reddit, crawling) ──
APIFY_TOKEN=
APIFY_SERP_ACTOR=apify~google-search-scraper
APIFY_REDDIT_ACTOR=trudax~reddit-scraper-lite
APIFY_CRAWLER_ACTOR=apify~website-content-crawler
# AI Mode uses the SERP actor add-on by default; set an actor here only to override it.
# Copilot has no built-in route: leave blank to disable.
APIFY_AI_MODE_ACTOR=
APIFY_COPILOT_ACTOR=

# ─── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ─── Google (Search Console + GA4 connect) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Resend). Without a key, emails are logged to the console ──
RESEND_API_KEY=
EMAIL_FROM=SeoWaveTech <hello@seowavetech.com>
